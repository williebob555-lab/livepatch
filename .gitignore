node_modules/

# Build output
dist/
dist-engine/
release/

# Bundled Node runtime for the engine (88 MB, regenerated by `npm run bundle:node`)
build/node.exe

# Player template + per-scene exes (116 MB, regenerated by `npm run build:player`)
build/player/

# Human handoff area: APKs to install, questions to answer, credentials to fix.
# Artifacts only — nothing here is an original. See dev/README.md.
dev/

# Capacitor web payload (`npm run android:app` / `android:player`)
build/android-www/
android/

# Native addon build trees (regenerated by `npm run build:vsthost`)
native/vsthost/build/

# Stray capture files from debugging runs
br-err.txt
br-out.bin
pkg-err.txt
pkg-out.txt

# Generated Android icon/splash intermediates
build/android-assets/
